# Copia este archivo a .env y coloca tus claves

# API via OpenCode Go (recomendado)
# Define explicitamente el modelo DeepSeek para evitar usar otro del gateway.
OPENCODE_GO_API_KEY=tu_api_key_de_deepseek_aqui
OPENCODE_GO_API_BASE=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# Fallback directo (opcional, solo si no usas OpenCode Go)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# (Opcional) Solo si no usas OpenCode Go — fallback directo
# DEEPSEEK_API_KEY=
